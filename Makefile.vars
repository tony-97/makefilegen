# Disable make builtin rules and variables
# https://stackoverflow.com/a/71184668
MAKEFLAGS += rR
$(foreach x,$(filter-out .% MAKE% SHELL CURDIR,$(.VARIABLES)) MAKEINFO,$(if $(filter default,$(origin $x)),$(eval override undefine $x)))

#==============================================================================
# Converts ascii string to lower
#==============================================================================
# $(1) : string to convert
export to_lower = $(subst A,a,$(subst B,b,$(subst C,c,$(subst D,d,$(subst E,e,$(subst F,f,$(subst G,g,$(subst H,h,$(subst I,i,$(subst J,j,$(subst K,k,$(subst L,l,$(subst M,m,$(subst N,n,$(subst O,o,$(subst P,p,$(subst Q,q,$(subst R,r,$(subst S,s,$(subst T,t,$(subst U,u,$(subst V,v,$(subst W,w,$(subst X,x,$(subst Y,y,$(subst Z,z,$1))))))))))))))))))))))))))

#==============================================================================
# Compares if matches the compiler
#==============================================================================
# $(1) : compiler to compare
# $(2) : compiler
COMPILER_NAME = $(findstring $(1),$(basename $(notdir $(2))))

#==============================================================================
# Check if its a compiler toolchain
#==============================================================================
# $(1) : c   compiler
# $(2) : c++ compiler
CHECK_COMPILER = $(filter $(1) $(2),$(call COMPILER_NAME,$(1),$(CC)) $(call COMPILER_NAME,$(2),$(CXX)))

define DEFINE_COMPILER
ifneq ($(call CHECK_COMPILER,$(1),$(2)),)
    ifndef CLANG
        export $(3) := 1
        ifneq ($(call COMPILER_NAME,$(2),$(CXX)),)
            export LD ?= $(CXX)
        else
            export LD ?= $(CC)
        endif
    endif
endif
endef

ifeq ($(TARGET),WEB)
    export CC  := emcc
    export CXX := em++
    export AR  := emar
endif

ifeq ($(OS),Windows_NT)
    export PLATFORM_HOST_WINDOWS := 1
    export TARGET ?= WINDOWS
else
    export PLATFORM_HOST_UNIX := 1
    UNAME_S := $(shell uname -s)
    ifeq ($(UNAME_S),Linux)
        export PLATFORM_HOST_LINUX := 1
        export TARGET ?= LINUX
    endif
    ifeq ($(UNAME_S),Darwin)
        export PLATFORM_HOST_DARWIN := 1
        export TARGET ?= OSX
    endif
endif # detect more host platforms

ifeq ($(TARGET),ANDROID)
    ANDROID_ARCH ?= arm64
    ANDROID_API_VERSION ?= 35
    ifdef ANDROID_HOME
        ANDROID_NDK ?= $(firstword $(wildcard $(ANDROID_HOME)/ndk/*))
    endif
    ifdef PLATFORM_HOST_WINDOWS
        ANDROID_NDK ?= C:/android-ndk
        ANDROID_TOOLCHAIN := $(ANDROID_NDK)/toolchains/llvm/prebuilt/windows-x86_64
    else
		ANDROID_NDK ?= /usr/lib/android/ndk
		ifdef PLATFORM_HOST_DARWIN
			ANDROID_TOOLCHAIN := $(ANDROID_NDK)/toolchains/llvm/prebuilt/darwin-x86_64
		else
			ANDROID_TOOLCHAIN := $(ANDROID_NDK)/toolchains/llvm/prebuilt/linux-x86_64
		endif
    endif

    ANDROID_SYSROOT ?= $(ANDROID_TOOLCHAIN)/sysroot

    ARCH_MAP_arm    := armv7a
    ARCH_MAP_arm64  := aarch64
    ARCH_MAP_x86    := i686
    ARCH_MAP_x86_64 := x86_64

    ABI_MAP_arm    := linux-androideabi
    ABI_MAP_arm64  := linux-android
    ABI_MAP_x86    := linux-android
    ABI_MAP_x86_64 := linux-android

    APK_ABI_arm    := armeabi-v7a
    APK_ABI_arm64  := arm64-v8a
    APK_ABI_x86    := x86
    APK_ABI_x86_64 := x86_64

    ANDROID_ARCH_NAME = $(ARCH_MAP_$(ANDROID_ARCH))
    ANDROID_APK_ABI   = $(APK_ABI_$(ANDROID_ARCH))
    ANDROID_COMPILER_ARCH = $(or $(ANDROID_ARCH_NAME),$(error ANDROID_COMPILER_ARCH: Unknown ANDROID_ARCH=$(ANDROID_ARCH)))

    ANDROID_ABI = $(ABI_MAP_$(ANDROID_ARCH))

    AR = $(ANDROID_TOOLCHAIN)/bin/llvm-ar

    ifeq ($(wildcard $(ANDROID_TOOLCHAIN)/bin/clang),)
        # OLD NDK SYSTEM (r19-r25): Uses the prefixed executable naming layout
        CC  = $(ANDROID_TOOLCHAIN)/bin/$(ANDROID_COMPILER_ARCH)-$(ANDROID_ABI)$(ANDROID_API_VERSION)-clang
        CXX = $(CC)++
    else
        # MODERN NDK SYSTEM (r26+): Uses unified clang binaries
        CC  = $(ANDROID_TOOLCHAIN)/bin/clang
        CXX = $(ANDROID_TOOLCHAIN)/bin/clang++
    endif

    ACFLAGS_MAP_arm    = -target armv7a-linux-android$(ANDROID_API_VERSION) -march=armv7-a -mfloat-abi=hard -mfpu=neon -m32
    ACFLAGS_MAP_arm64  = -target aarch64-linux-android$(ANDROID_API_VERSION) -march=armv8-a -m64
    ACFLAGS_MAP_x86    = -target i686-linux-android$(ANDROID_API_VERSION) -march=i686 -m32
    ACFLAGS_MAP_x86_64 = -target x86_64-linux-android$(ANDROID_API_VERSION) -march=x86-64 -m64

    ANDROIDFLAGS  = $(ACFLAGS_MAP_$(ANDROID_ARCH))

    # 2. Security and Code Layout Attributes
    # Removed -fPIE because modern Clang enforces PIE (Position Independent Executable) by default.
    ANDROIDFLAGS += -ffunction-sections -funwind-tables -fstack-protector-strong -fPIC

    # 3. Compiler & Assembler Diagnostic Tuning
    # Removed -Wa,--noexecstack because Clang now rejects raw GNU assembler flags and applies noexecstack natively.
    ANDROIDFLAGS += -Wformat -Werror=format-security -no-canonical-prefixes

    CFLAGS   += $(ANDROIDFLAGS)
    CXXFLAGS += $(ANDROIDFLAGS)

    LDFLAGS  += $(ANDROIDFLAGS)

    # 4. Global Target Macros
    DEFINES += __ANDROID__ __ANDROID_API__=$(ANDROID_API_VERSION)

    NATIVE_APP_GLUE = $(ANDROID_NDK)/sources/android/native_app_glue
    INCLUDE_DIRS += $(NATIVE_APP_GLUE) $(ANDROID_SYSROOT)/usr/include
    INCLUDE_DIRS += $(ANDROID_SYSROOT)/usr/include/$(ANDROID_ARCH_NAME)-$(ANDROID_ABI)
    EXTRA_SRCS_C += $(NATIVE_APP_GLUE)/android_native_app_glue.c

    LDFLAGS += -Wl,--build-id -Wl,-z,noexecstack -Wl,-z,relro -Wl,-z,now -Wl,--warn-shared-textrel -Wl,--fatal-warnings
    # Force linking of library module to define symbol
    LDFLAGS += -u ANativeActivity_onCreate
    # Avoid unresolved symbol pointing to external main()
    LDFLAGS += -Wl,-undefined,dynamic_lookup
    # Wrap fopen at link time so all code (including third-party libs) goes
    # through __wrap_fopen, which handles Android APK asset loading
    LDFLAGS += -Wl,--wrap=fopen
endif

$(eval $(call DEFINE_COMPILER,clang,clang++,CLANG))
$(eval $(call DEFINE_COMPILER,gcc,g++,GCC))
$(eval $(call DEFINE_COMPILER,emcc,em++,EMSCRIPTEN))
$(eval $(call DEFINE_COMPILER,cl,cl,MSVC))

ifdef PLATFORM_HOST_WINDOWS
    export MAKEDIR = if not exist "$$(subst /,\,$$(1))" mkdir "$$(subst /,\,$$(1))"
    export REMOVE  = if exist "$$(subst /,\,$$(1))" rmdir /s /q "$$(subst /,\,$$(1))"
else
    export MAKEDIR = mkdir -p $$1
    export REMOVE  = rm -fR $$1
endif

#==============================================================================
# Build directory (OS-specific)
#==============================================================================
export BUILD_DIR = build$(addprefix _,$(call to_lower,$(TARGET)))

#==============================================================================
# Build mode (debug/release/sanitizer variants)
# Formerly in Makefile.options — now unified here so all variables are
# available at include time without an intermediate sub-make.
#==============================================================================
ifndef MSVC
    AFLAGS := -fsanitize=undefined -fno-omit-frame-pointer
    ifdef CLANG
        AFLAGS += -fsanitize=nullability
    endif
    ifeq ($(MEMORY),1)
        AFLAGS += -fsanitize=memory -fPIE -pie -fsanitize-memory-track-origins
    else
        AFLAGS += -fsanitize=address -fsanitize-address-use-after-scope
    endif
endif

VGFLAGS := -s --leak-check=full --show-leak-kinds=all --track-origins=yes

ifeq ($(BUILD_MODE),RELEASE)
    BUILD_MODE_NAME := release
    CXXFLAGS   += $(RELEASE_FLAGS)
    CFLAGS     += $(RELEASE_FLAGS)
else
    BUILD_MODE_NAME := debug
    CXXFLAGS   += $(DEBUG_FLAGS)
    CFLAGS     += $(DEBUG_FLAGS)
ifndef MSVC
    WFLAGS += -Wno-unused-parameter
endif
ifeq ($(ASAN),1)
    ASAN_OPTIONS := strict_string_checks=1:detect_stack_use_after_return=1:check_initialization_order=1:strict_init_order=1
    LDFLAGS  += $(AFLAGS)
    CXXFLAGS += $(AFLAGS)
    CFLAGS += $(AFLAGS)
ifeq ($(MEMORY),1)
    BUILD_MODE_NAME := $(BUILD_MODE_NAME)_msan
else
    BUILD_MODE_NAME := $(BUILD_MODE_NAME)_asan
endif
endif
endif

#==============================================================================
# Derived paths
#==============================================================================
BUILD_MODE_PATH := $(BUILD_DIR)/$(BUILD_MODE_NAME)

export CPPFLAGS
export CXXFLAGS
export CFLAGS
export LDFLAGS
export LDLIBS
export WFLAGS
export OBJ_DIR    := $(BUILD_MODE_PATH)/obj
export BUILD_PATH := $(BUILD_MODE_PATH)
export ROOT_PATH  := $(BUILD_DIR)

EXEC_FILE := $(BUILD_MODE_PATH)/$(EXEC_NAME)

#==============================================================================
# MK_DEPS_IMPL
#==============================================================================
# $(1) : Compiler
# $(2) : Source to get its deps C/C++
# $(3) : Target to generate
# $(4) : Deps to output
# $(5) : Compiler preprocessor flags
# $(6) : Compiler flags
#==============================================================================
# MK_LIB
#==============================================================================
# $(1) : AR
# $(2) : ARFLAGS
# $(3) : Lib name
# $(4) : OBJS
#==============================================================================
# COMPILE_ONLY
#==============================================================================
# $(1) : Compiler
# $(2) : Source to compile C/C++
# $(3) : Object to output
# $(4) : Compiler preprocessor flags
# $(5) : Compiler flags
#==============================================================================
# LINK_EXEC
#==============================================================================
# $(1) : LD
# $(2) : EXEC_NAME
# $(3) : OBJS
# $(4) : LDLIBS
# $(5) : LDFLAGS
ifdef MSVC
    export MK_INCLUDES = $$(if $$(INCLUDE_DIRS),$$(addprefix /I ,$$(INCLUDE_DIRS)))
    export MK_DEFINES = $$(addprefix /D,$$(DEFINES))
    export MK_LIBS_PATH = $$(if $$(LIBS_PATH),$$(addprefix /LIBPATH:,$$(LIBS_PATH)))
    export MK_DEPS_IMPL = $(info [INFO] dependency generation for MSVC not implemented yet)
    export MK_LIB = $$1 $$2 $$4 /OUT:$$3 
    export COMPILE_ONLY_IMPL = $$1 /c $$2 /Fo: $$3 $$4 $$5
    export LINK_EXEC = $$1 $$3 /Fe: $$2 $$4 /link $$5
    export AR ?= lib
    export ARFLAGS ?= 
    export WFLAGS := /Wall
else
    export MK_INCLUDES = $$(addprefix -I ,$$(INCLUDE_DIRS))
    export MK_DEFINES = $$(addprefix -D,$$(DEFINES))
    export MK_LIBS_PATH = $$(addprefix -L ,$$(LIBS_PATH))
    export MK_DEPS_IMPL = $$1 $$2 -E -MMD -MP -MT $$3 -MF $$4 -o $$(ROOT_PATH)/dummy.i $$5 $$6
    export MK_LIB = $$1 $$2 $$3 $$4
    export COMPILE_ONLY_IMPL = $$1 -c $$2 -o $$3 $$4 $$5
    export LINK_EXEC = $$1 -o $$2 $$3 $$4 $$5
    export AR ?= ar
    export ARFLAGS ?= rcs
    export WFLAGS := -W -Wall -Wextra -Wpedantic -pedantic -Wshadow -Weffc++
endif
